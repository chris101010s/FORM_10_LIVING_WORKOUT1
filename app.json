{
  "expo": {
    "name": "FORM 15.0.0",
    "slug": "athlete-os",
    "scheme": "athleteos",
    "version": "15.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF9F3",
    "ios": {
      "bundleIdentifier": "app.athleteos.personal",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Optional: ein Foto für eine eigene Übung auswählen.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSFaceIDUsageDescription": "Optionaler Schutz deiner privaten Trainings- und Gesundheitsdaten."
      },
      "icon": "./assets/icons/ink.png",
      "buildNumber": "150002"
    },
    "android": {
      "package": "app.athleteos.personal",
      "versionCode": 150002
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-document-picker",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "expo-local-authentication",
      "./plugins/withBuildVersion"
    ],
    "extra": {
      "privacy": "All personal data remains on device until user explicitly exports or shares it."
    },
    "icon": "./assets/icons/ink.png"
  }
}
